{
  "kind": "collectionType",
  "collectionName": "users",
  "info": {
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "users-permissions": {
      "advanced": {
        "unique_email": true
      }
    }
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "required": true,
      "unique": true
    },
    "provider": {
      "type": "string"
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "private": true
    },
    "resetPasswordToken": {
      "type": "string",
      "private": true
    },
    "confirmationToken": {
      "type": "string",
      "private": true
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    },
    "blocked": {
      "type": "boolean",
      "default": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users"
    },
    "peran": {
      "type": "enumeration",
      "enum": [
        "Dosen",
        "Mahasiswa",
        "Admin"
      ]
    },
    "dosen": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::dosen.dosen",
      "mappedBy": "users_permissions_user"
    },
    "mahasiswa": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::mahasiswa.mahasiswa",
      "mappedBy": "users_permissions_user"
    },
    "jabatan": {
      "type": "string"
    }
  }
}
